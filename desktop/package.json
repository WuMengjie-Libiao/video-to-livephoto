{
  "name": "video-to-livephoto",
  "version": "0.1.0",
  "private": true,
  "description": "视频转实况照片 · 本地离线桌面工具",
  "author": "suikiiovo",
  "license": "MIT",
  "copyright": "MIT © 2026 suikiiovo",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build:native && node scripts/dev.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:ui": "vite build",
    "build:win": "vite build && electron-builder --win --config electron-builder.yml",
    "build:mac": "npm run build:native && vite build && electron-builder --mac --config electron-builder.yml",
    "build:slim": "vite build && electron-builder --win portable --config electron-builder.slim.yml",
    "test:core": "node --test scripts/test-core.cjs",
    "icon": "python build/make-icon.py",
    "start": "npm run build:native && vite build && electron .",
    "build:native": "node scripts/build-native.mjs",
    "test:desktop": "vite build && electron scripts/test-desktop.cjs",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "minimatch@^9.0.3": "^11.0.1",
    "minimatch@^10.2.5": "^11.0.1"
  }
}
